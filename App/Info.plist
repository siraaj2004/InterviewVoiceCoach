<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AI Interview Voice</string>
	<key>CFBundleIdentifier</key>
	<string>com.shaik.aiinterviewvoice</string>
	<key>CFBundleName</key>
	<string>AIInterviewVoice</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2.0</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>CFBundleExecutable</key>
	<string>AIInterviewVoice</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string></string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>The interview coach needs the microphone so you can answer interview questions by speaking, and it can check your spoken English.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your spoken answers are transcribed on your iPhone so the app can score your content and English and speak the correction back to you. Audio is not uploaded.</string>
	<key>NSCameraUsageDescription</key>
	<string>The interview coach uses the front camera only while you answer, to observe your posture, eye contact and movement and give body-language tips. No video is recorded, saved or uploaded.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
